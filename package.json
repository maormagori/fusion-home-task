{
  "name": "feedback-insights-service",
  "version": "1.0.0",
  "description": "Accepts user feedback and analyzes it asynchronously with an LLM",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:llm": "vitest run --config vitest.llm.config.ts",
    "db:generate": "drizzle-kit generate"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "http-status-codes": "^2.3.0",
    "openai": "^7.60.0",
    "p-queue": "^10.0.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "private": true
}
